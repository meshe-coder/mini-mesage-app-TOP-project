<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>New Message</title>
	<link rel="stylesheet" href="/styles.css">
</head>
<body>
	<main>
		<p class="eyebrow">Add to the conversation</p>
		<h1>Write a new message</h1>
		<form method="POST" action="/new">
			<label for="user">Your name</label>
			<input type="text" id="user" name="user" placeholder="e.g. Alex" required>

			<label for="text">Message</label>
			<textarea id="text" name="text" rows="5" placeholder="What would you like to say?" required></textarea>

			<button type="submit">Submit</button>
		</form>
		<a class="back-link" href="/">← Back to messages</a>
	</main>
</body>
</html>
